# ==============================================================================
# CivicFix Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or real secrets into version control.

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/civicfix
# MongoDB Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/civicfix?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# Session Secret (Minimum 32 cryptographically random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=civicfix_production_session_secret_32_chars_minimum_length_required!

# Session Cookie Configuration
SESSION_COOKIE_NAME=civicfix.sid
SESSION_TTL_HOURS=24
COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# Allowed Client Origins for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Transactional Email Notification Service (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CivicFix Platform <notifications@civicfix.org>

# Logging Verbosity (error | warn | info | debug)
LOG_LEVEL=debug
